{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Download raw data",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.download_data",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Build dataset",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.build_dataset",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run evaluation",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.run_evaluation",
      "cwd": "${workspaceFolder}"
    }
  ]
}
